[sub_resource type="GDScript" id="GDScript_ivy63"]
script/source = "extends RigidBody2D
const SPEED = 300.0
var municao = 2

func atirar():
	if municao > 0:
		municao -= 1
		var b = load(\"res://morte.tscn\")
		var i = b.instantiate()
		i.position = self.position + get_local_mouse_position().normalized() * 500
		i.linear_velocity = get_local_mouse_position()* 10
		get_parent().add_child(i)
	match municao:
		2:
			$Sprite2D.texture = load(\"res://Untitled 11-21-2026 09-54-23 (1).png\")
		1:
			$Sprite2D.texture = load(\"res://Untitled 11-21-2026 09-54-23 (2)(1).png\")
		0:
			$Sprite2D.texture = load(\"res://Untitled 11-21-2026 09-54-23 (3).png\")
func _physics_process(delta: float) -> void:
	angular_velocity = 0
	rotation = 0
	var direction = Input.get_vector(\"ui_left\",\"ui_right\",\"ui_up\",\"ui_down\")
	linear_velocity = direction*400
	if Input.is_action_just_pressed(\"at\"):
		atirar()


func _on_body_entered(body: Node) -> void:
	municao += 1
	if str(body.name)[0] == \"m\":
		body.queue_free()
	pass # Replace with function body.
"

